# Gemini API Key for server-side AI reasoning & copilot endpoints (/api/ai/*)
GEMINI_API_KEY=

# Optional: Port configuration (default 3000)
PORT=3000

# Optional: Enable demo mode for pre-seeded research personas (default true)
DEMO_MODE=true

# Supabase Configuration (Optional - app gracefully operates in Local-Only sovereign mode if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=